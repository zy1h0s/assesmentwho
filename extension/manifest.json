{
  "manifest_version": 3,
  "name": "Claude Screenshot Helper",
  "version": "1.0.0",
  "description": "Floating tool for screenshots and text input to Claude.ai",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Claude Screenshot Helper"
  }
}
